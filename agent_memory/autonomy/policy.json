{
  "schema_version": 1,
  "name": "Hixton Continuous Improvement Policy",
  "mode": "AUTONOMOUS_RESEARCH_AND_ENGINEERING",
  "objective": {
    "capital_usdc": "250.00",
    "symbols": 10,
    "primary": "increase robust net profit after costs while increasing meaningful deployment of the fixed 250 USDC research budget",
    "secondary": "increase completed position cycles per calendar day, slot utilization and average deployed notional while reducing zero-position hours, longest idle stretches and avoidable NO_FREE_SLOT loss",
    "never_optimize_for": [
      "headline trade count alone",
      "tiny-order fragmentation",
      "single-window profit alone",
      "in-sample fit alone"
    ],
    "future_readiness": "prefer mechanisms that survive plausible unseen regimes, execution degradation and newly arriving data over mechanisms that maximize historical fit"
  },
  "allowed_research": [
    "per-coin strategy parameters",
    "entry timing",
    "exit timing",
    "holding duration",
    "stop and trailing policy",
    "signal filters",
    "slot count with fixed 250 USDC total capital",
    "allocation and ranking policy",
    "one-per-symbol versus ranked-repeat",
    "opportunity-cost routing",
    "risk controls",
    "execution-cost robustness",
    "point-in-time event and news risk features",
    "new strategy families proposed by the hypothesis dot"
  ],
  "hard_constraints": {
    "fixed_total_capital_usdc": "250.00",
    "leverage_allowed": false,
    "private_binance_credentials_in_cloud": false,
    "real_money_orders_in_cloud": false,
    "testnet_orders_in_cloud": false,
    "historical_result_may_be_called_guaranteed": false,
    "research_only_leverage_simulation_allowed": true,
    "live_margin_allowed": false,
    "live_futures_allowed": false,
    "minimum_research_tranche_usdc": "50.00",
    "frequency_may_not_be_gamed_by_splitting_orders": true
  },
  "anti_overfit": {
    "training_only_may_rank_candidates": true,
    "validation_may_reject_not_select": true,
    "baseline_and_stress_required": true,
    "full_three_year_required": true,
    "cross_window_robustness_required_before_auto_apply": true,
    "minimum_positive_cross_windows": 2,
    "minimum_cross_windows": 3,
    "profile_and_runner_hash_parity_required": true,
    "paper_forward_evidence_required_before_live_activation": true,
    "shifted_full_three_year_required_before_auto_apply": true,
    "independent_red_team_required_before_auto_apply": true,
    "future_readiness_gate_required_before_auto_apply": true,
    "recent_proxy_windows_are_rejection_only": true,
    "recent_proxy_results_must_not_tune_next_candidate": true,
    "extreme_execution_cost_gate_required": true
  },
  "promotion": {
    "engineering_auto_apply_allowed": true,
    "requires_exact_head_a01_a11": true,
    "requires_qa_pass": true,
    "requires_governance_pass": true,
    "requires_non_regressive_baseline_equity": false,
    "requires_non_regressive_stress_equity": false,
    "trade_frequency_gain_is_sufficient_alone": false,
    "paper_auto_activate": false,
    "live_auto_activate": false,
    "automatic_real_money_change": false,
    "candidate_branch_required": true,
    "whitelisted_candidate_mutation_only": true,
    "stable_head_must_match_candidate_base_at_promotion": true,
    "activity_candidate_min_equity_ratio_vs_incumbent": "0.85",
    "activity_candidate_minimum_cycles_3y": 157,
    "activity_candidate_preferred_max_equity_regression_pct": "10",
    "activity_candidate_hard_max_equity_regression_pct": "15"
  },
  "continuity": {
    "keep_researching_after_failure": true,
    "record_negative_experiments": true,
    "do_not_repeat_rejected_region_without_new_evidence": true,
    "next_hypothesis_must_be_evidence_led": true,
    "target_cycle_hours": 6,
    "hypothesis_queue_required": true,
    "event_archive_is_append_only": true
  },
  "intelligence_budget": {
    "deterministic_first": true,
    "model_calls_for_status": 0,
    "model_calls_for_known_checks": 0,
    "model_calls_for_known_repairs": 0,
    "novel_hypothesis_escalation_only": true,
    "max_novel_escalations_per_day": 2
  },
  "research_scope": {
    "product_contract_is_not_research_ceiling": true,
    "research_may_challenge_current_coin_universe": true,
    "research_may_challenge_current_allocator": true,
    "research_may_test_secondary_strategy_layers": true,
    "research_may_test_alternative_timeframes_offline": true,
    "research_may_simulate_leverage_offline": true,
    "live_market_universe_changes_require_full_promotion_and_owner_live_activation": true,
    "live_margin_futures_leverage_remains_forbidden": true
  },
  "forward_evidence": {
    "enabled": true,
    "mode": "SHADOW_ONLY",
    "optimization_from_forward_window_forbidden": true,
    "purpose": "observe newly arriving closed bars after engineering promotion and compare actual Paper/public-market behavior with strategy expectations before any Live activation",
    "minimum_observation_hours_before_live_review": 168,
    "live_activation_automatic": false
  },
  "activity_mission": {
    "id": "MISSION-CAPITAL-ACTIVITY-250",
    "target_account_capital_usdc": "250.00",
    "preferred_outcome": "more frequent meaningful 50-250 USDC simulated deployment with non-regressive baseline/stress profit",
    "mandatory_metrics": [
      "position_cycles_per_day",
      "slot_trades_per_day",
      "slot_utilization_pct",
      "average_deployed_notional_usdc",
      "zero_position_pct",
      "longest_idle_hours",
      "profit_per_calendar_day_usdc",
      "blocked_no_free_slot"
