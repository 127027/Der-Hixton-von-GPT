{
  "schema_version": 1,
  "name": "Hixton Continuous Improvement Policy",
  "mode": "AUTONOMOUS_RESEARCH_AND_ENGINEERING",
  "objective": {
    "capital_usdc": "CONFIGURED_C",
    "symbols": "10_CORE_PLUS_UP_TO_5_VALIDATED_SATELLITES",
    "primary": "maximize robust shared-account net return and productive capital-time from one configured budget C using the validated core plus only satellites that add marginal after-cost portfolio value",
    "secondary": "increase completed position cycles per calendar day, slot utilization and average deployed notional while reducing zero-position hours, longest idle stretches and avoidable NO_FREE_SLOT loss",
    "never_optimize_for": [
      "headline trade count alone",
      "tiny-order fragmentation",
      "single-window profit alone",
      "in-sample fit alone"
    ],
    "future_readiness": "prefer mechanisms that survive plausible unseen regimes, execution degradation and newly arriving data over mechanisms that maximize historical fit"
  },
  "allowed_research": [
    "per-coin strategy parameters",
    "entry timing",
    "exit timing",
    "holding duration",
    "stop and trailing policy",
    "signal filters",
    "slot count, tranche sizing and reserve derived from configured total capital C",
    "allocation and ranking policy",
    "one-per-symbol versus ranked-repeat",
    "opportunity-cost routing",
    "risk controls",
    "execution-cost robustness",
    "point-in-time event and news risk features",
    "new strategy families proposed by the hypothesis dot",
    "preemptible idle-satellite market layer",
    "cross-quote historical proxy research with real-USDC holdout validation",
    "opportunity-value handoff between running Core/Satellite positions and superior new opportunities",
    "scale-invariant opportunity-value routing between running positions and new candidates",
    "expected net return percent and return-per-risk/time ranking",
    "bounded early satellite exits when a superior normalized opportunity justifies switching"
  ],
  "hard_constraints": {
    "leverage_allowed": false,
    "private_binance_credentials_in_cloud": false,
    "real_money_orders_in_cloud": false,
    "testnet_orders_in_cloud": false,
    "historical_result_may_be_called_guaranteed": false,
    "research_only_leverage_simulation_allowed": true,
    "live_margin_allowed": false,
    "live_futures_allowed": false,
    "minimum_research_tranche_usdc": "50.00",
    "frequency_may_not_be_gamed_by_splitting_orders": true,
    "fixed_usdc_switch_thresholds_allowed": false,
    "single_user_capital_source": "max_capital_usdc",
    "reference_research_capital_usdc": "250.00",
    "router_fixed_absolute_usdc_thresholds_forbidden": true
  },
  "anti_overfit": {
    "training_only_may_rank_candidates": true,
    "validation_may_reject_not_select": true,
    "baseline_and_stress_required": true,
    "full_three_year_required": true,
    "cross_window_robustness_required_before_auto_apply": true,
    "minimum_positive_cross_windows": 2,
    "minimum_cross_windows": 3,
    "profile_and_runner_hash_parity_required": true,
    "paper_forward_evidence_required_before_live_activation": true,
    "shifted_full_three_year_required_before_auto_apply": true,
    "independent_red_team_required_before_auto_apply": true,
    "future_readiness_gate_required_before_auto_apply": true,
    "recent_proxy_windows_are_rejection_only": true,
    "recent_proxy_results_must_not_tune_next_candidate": true,
    "extreme_execution_cost_gate_required": true
  },
  "promotion": {
    "engineering_auto_apply_allowed": true,
    "requires_exact_head_a01_a11": true,
    "requires_qa_pass": true,
    "requires_governance_pass": true,
    "requires_non_regressive_baseline_equity": true,
    "requires_non_regressive_stress_equity": true,
    "trade_frequency_gain_is_sufficient_alone": false,
    "paper_auto_activate": false,
    "live_auto_activate": false,
    "automatic_real_money_change": false,
    "candidate_branch_required": true,
    "whitelisted_candidate_mutation_only": true,
    "stable_head_must_match_candidate_base_at_promotion": true,
    "activity_candidate_min_equity_ratio_vs_incumbent": "0.85",
    "activity_candidate_minimum_cycles_3y": 157,
    "activity_candidate_preferred_max_equity_regression_pct": "10",
    "activity_candidate_hard_max_equity_regression_pct": "15",
    "activity_candidate_exception": {
      "applies_only_to": "satellite/idle-capacity architecture candidates",
      "min_equity_ratio_vs_incumbent": "1.00",
      "minimum_cycles_3y": 0,
      "core_trade_displacement_allowed": true,
      "requires_incremental_satellite_profit_after_costs": true,
      "displacement_requires_validated_point_in_time_router": true,
      "requires_idle_time_reduction": true
    }
  },
  "continuity": {
    "keep_researching_after_failure": true,
    "record_negative_experiments": true,
    "do_not_repeat_rejected_region_without_new_evidence": true,
    "next_hypothesis_must_be_evidence_led": true,
    "target_cycle_hours": 6,
    "hypothesis_queue_required": true,
    "event_archive_is_append_only": true,
    "priority_path_target_minutes": 30,
    "avoid_recomputing_frozen_stage_evidence": true
  },
  "intelligence_budget": {
    "deterministic_first": true,
    "model_calls_for_status": 0,
    "model_calls_for_known_checks": 0,
    "model_calls_for_known_repairs": 0,
    "novel_hypothesis_escalation_only": true,
    "max_novel_escalations_per_day": 2
  },
  "research_scope": {
    "product_contract_is_not_research_ceiling": true,
    "research_may_challenge_current_coin_universe": true,
    "research_may_challenge_current_allocator": true,
    "research_may_test_secondary_strategy_layers": true,
    "research_may_test_alternative_timeframes_offline": true,
    "research_may_simulate_leverage_offline": true,
    "live_market_universe_changes_require_full_promotion_and_owner_live_activation": true,
    "live_margin_futures_leverage_remains_forbidden": true,
    "core_v6_is_primary_strategy": true,
    "satellite_layer_may_only_use_free_core_capacity": false,
    "satellite_layer_must_yield_to_core": false,
    "target_satellite_markets": 5,
    "proxy_history_requires_real_usdc_validation": true,
    "satellite_role": "IDLE_REPLACEMENT_WITH_SCALE_INVARIANT_OPPORTUNITY_ROUTING",
    "core_reclaim_priority_absolute": false,
    "direct_usdc_routing_preferred": true,
    "cross_quote_conversion_requires_separate_after_cost_evidence": true,
    "core_priority_absolute": false,
    "core_signal_alone_forces_satellite_exit": false,
    "opportunity_value_router_required": true,
    "point_in_time_switching_only": true,
    "routing_must_scale_with_account_and_position_size": true,
    "fixed_absolute_profit_loss_switch_thresholds_forbidden": true,
    "dynamic_capital_C_required": true,
    "isolated_15xC_is_diagnostic_only": true,
    "shared_portfolio_C_is_actual_account": true
  },
  "forward_evidence": {
    "enabled": true,
    "mode": "SHADOW_ONLY",
    "optimization_from_forward_window_forbidden": true,
    "purpose": "observe newly arriving closed bars after engineering promotion and compare actual Paper/public-market behavior with strategy expectations before any Live activation",
    "minimum_observation_hours_before_live_review": 168,
    "live_activation_automatic": false
  },
  "activity_mission": {
    "id": "MISSION-SATELLITE-SHARED-C",
    "target_account_capital_usdc": "CONFIGURED_C_REFERENCE_250",
    "preferred_outcome": "higher robust net profit and lower avoidable idle time from the same shared account C; activity alone is not success",
    "mandatory_metrics": [
      "position_cycles_per_day",
      "slot_trades_per_day",
      "slot_utilization_pct",
      "average_deployed_notional_usdc",
      "zero_position_pct",
      "longest_idle_hours",
      "profit_per_calendar_day_usdc",
      "blocked_no_free_slot"
    ],
    "profit_and_future_readiness_remain_hard_gates": true,
    "frequency_tiers_3y": {
      "stretch_cycles": 1095,
      "stretch_label": "~1 completed position cycle per day",
      "good_cycles": 365,
      "good_label": "~1 per 3 days",
      "minimum_acceptable_cycles": 157,
      "minimum_label": "~1 per 7 days",
      "below_minimum_is_success": false
    },
    "profit_concession": {
      "preferred_max_regression_pct": "0",
      "hard_max_regression_pct": "0",
      "hard_min_equity_ratio_vs_protected_incumbent": "0.85",
      "applies_to": [
        "baseline",
        "stress"
      ],
      "note": "Activity candidates may trade some historical ending equity for materially lower idle time, but collapse toward ~1000 from a ~1500-1560 incumbent is unacceptable.",
      "hard_min_equity_ratio_vs_incumbent": "1.00"
    },
    "continue_after_minimum_tier": true,
    "satellite_contract": {
      "purpose": "Monetize otherwise idle/free capital and reallocate it when a materially better opportunity appears.",
      "core_is_primary_high_value_engine": true,
      "core_signal_is_not_automatic_preemption": true,
      "scale_invariant_routing_required": true,
      "fixed_usdc_switch_thresholds_forbidden": true,
      "switching_rule": "Compare normalized point-in-time opportunity scores based on expected net return on allocated capital, risk, time horizon and uncertainty; subtract normalized exit/entry/conversion costs and switch only when the improvement clears a validated margin.",
      "early_satellite_exit_outcomes_allowed": [
        "profit",
        "break_even",
        "bounded_loss"
      ],
      "target_profit_does_not_force_holding": true,
      "no_future_information": true,
      "accounting_required": [
        "expected net return percent of current position remaining",
        "expected net return percent of candidate",
        "risk-adjusted opportunity score",
        "expected return per unit time",
        "fees spread slippage and conversion costs as percent/basis points",
        "early-exit realized return percent",
        "handoff latency",
        "switch regret for ex-post evaluation only"
      ],
      "quote_policy": "Prefer direct USDC Spot. Cross-quote routing remains research-only until separately proven superior after normalized costs and operational failure modes.",
      "success_definition": "Increase robust shared-portfolio return and capital utilization while avoiding cost-negative churn; behavior must remain valid if the account is later scaled above or below the current research capital."
    }
  }
}
