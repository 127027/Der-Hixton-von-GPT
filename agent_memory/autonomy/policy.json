    "profit_and_future_readiness_remain_hard_gates": true,
    "frequency_tiers_3y": {
      "stretch_cycles": 1095,
      "stretch_label": "~1 completed position cycle per day",
      "good_cycles": 365,
      "good_label": "~1 per 3 days",
      "minimum_acceptable_cycles": 157,
      "minimum_label": "~1 per 7 days",
      "below_minimum_is_success": false
    },
    "profit_concession": {
      "preferred_max_regression_pct": "10",
      "hard_max_regression_pct": "15",
      "hard_min_equity_ratio_vs_protected_incumbent": "0.85",
      "applies_to": [
        "baseline",
        "stress"
      ],
      "note": "Activity candidates may trade some historical ending equity for materially lower idle time, but collapse toward ~1000 from a ~1500-1560 incumbent is unacceptable."
    },
    "continue_after_minimum_tier": true
  }
