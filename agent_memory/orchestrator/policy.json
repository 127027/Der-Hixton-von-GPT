{
  "schema_version": 1,
  "name": "Hixton Master Orchestrator V1",
  "mode": "SHADOW_ONLY",
  "source_of_truth": "github",
  "cost_policy": {
    "default_ai_enabled": false,
    "default_max_ai_escalations_per_cycle": 0,
    "hard_max_ai_escalations_per_cycle": 2,
    "status_polling_may_use_ai": false,
